# Pramana environment configuration
# Copy this file to .env, then add your Gemini API key there.
# Never commit your real API key to source control.

# Generator: answers, questions, and concept graph extraction.
GEMINI_API_KEY=
PRAMANA_GENERATOR=google:gemini-3.8-flash

# Verifier / judge: use a different Gemini model for an independent second pass.
# Model availability may depend on your Google AI Studio project/account.
PRAMANA_VERIFIER=google:gemini-3.7-flash

# Bulk worker for figure descriptions and query rewriting (defaults to generator).
# Optional override:
# PRAMANA_BULK=google:gemini-3.5-flash-lite

# Retrieval
PRAMANA_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Decline low-similarity queries without calling the generator.
PRAMANA_COVERAGE_THRESHOLD=0.72
